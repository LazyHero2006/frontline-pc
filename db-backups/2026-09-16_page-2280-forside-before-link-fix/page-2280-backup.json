- wp:html -->\n<span class=\"fl-icon \"><svg xmlns=\"http://www.w3.org/2000/svg\" viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><rect width=\"20\" height=\"14\" x=\"2\" y=\"5\" rx=\"2\" /><line x1=\"2\" x2=\"22\" y1=\"10\" y2=\"10\" /></svg></span>\n<!-- /wp:html -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}}} -->\n<p style=\"margin-top:0;margin-bottom:0\">Delbetaling: Klarna &amp; Vipps</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"fl-usp__item\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group fl-usp__item\"><!-- wp:html -->\n<span class=\"fl-icon \"><svg xmlns=\"http://www.w3.org/2000/svg\" viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"m16 16 2 2 4-4\" /><path d=\"M21 10V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l2-1.14\" /><path d=\"m7.5 4.27 9 5.15\" /><polyline points=\"3.29 7 12 12 20.71 7\" /><line x1=\"12\" x2=\"12\" y1=\"22\" y2=\"12\" /></svg></span>\n<!-- /wp:html -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}}} -->\n<p style=\"margin-top:0;margin-bottom:0\">Levering 5-7 dager</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"className\":\"fl-wrap fl-klasser\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"72px\",\"bottom\":\"8px\"}}},\"layout\":{\"type\":\"default\"}} -->\n<section class=\"wp-block-group fl-wrap fl-klasser\" style=\"padding-top:72px;padding-bottom:8px\"><!-- wp:group {\"className\":\"fl-section-head\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group fl-section-head\"><!-- wp:group {\"className\":\"fl-section-head__copy\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group fl-section-head__copy\"><!-- wp:paragraph {\"className\":\"fl-eyebrow\"} -->\n<p class=\"fl-eyebrow\">Tre prisklasser</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Fighter. Ghost. Titan.</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Samme byggekvalitet i alle tre. Forskjellen er hvor høyt du sikter — 1080p, 1440p eller 4K uten kompromiss.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:html -->\n<a class=\"fl-link-arrow\" href=\"http://localhost:8090/products/\">Sammenlign alle spesifikasjoner<span class=\"fl-icon \"><svg xmlns=\"http://www.w3.org/2000/svg\" viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M5 12h14\" /><path d=\"m12 5 7 7-7 7\" /></svg></span></a>\n<!-- /wp:html --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"className\":\"fl-wrap fl-tiers\",\"layout\":{\"type\":\"default\"},\"anchor\":\"maskiner\"} -->\n<section id=\"maskiner\" class=\"wp-block-group fl-wrap fl-tiers\"><!-- wp:woocommerce/product-collection {\"queryId\":2,\"query\":{\"perPage\":3,\"pages\":1,\"offset\":0,\"postType\":\"product\",\"order\":\"asc\",\"orderBy\":\"menu_order\",\"search\":\"\",\"exclude\":[],\"inherit\":false,\"taxQuery\":[],\"isProductCollectionBlock\":true,\"featured\":true,\"woocommerceOnSale\":false,\"woocommerceStockStatus\":[\"instock\",\"outofstock\",\"onbackorder\"],\"woocommerceAttributes\":[],\"woocommerceHandPickedProducts\":[]},\"tagName\":\"div\",\"displayLayout\":{\"type\":\"flex\",\"columns\":3,\"shrinkColumns\":true},\"dimensions\":{\"widthType\":\"fill\"},\"collection\":\"woocommerce/product-collection/featured\",\"queryContextIncludes\":[\"collection\"]} -->\n<div class=\"wp-block-woocommerce-product-collection\"><!-- wp:woocommerce/product-template -->\n<!-- wp:woocommerce/product-image {\"showSaleBadge\":false,\"saleBadgeAlign\":\"left\",\"isDescendentOfQueryLoop\":true,\"scale\":\"contain\",\"aspectRatio\":\"4/3\"} -->\n<!-- wp:woocommerce/product-sale-badge {\"align\":\"left\"} /-->\n<!-- /wp:woocommerce/product-image -->\n\n<!-- wp:group {\"className\":\"fl-tiers__body\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group fl-tiers__body\"><!-- wp:post-terms {\"term\":\"product_cat\",\"className\":\"fl-tier-cat\"} /-->\n\n<!-- wp:post-title {\"level\":3,\"isLink\":true,\"__woocommerceNamespace\":\"woocommerce/product-collection/product-title\"} /-->\n\n<!-- wp:frontline-pc/product-specs /-->\n\n<!-- wp:group {\"className\":\"fl-tiers__price-row\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group fl-tiers__price-row\"><!-- wp:group {\"className\":\"fl-tiers__price-col\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group fl-tiers__price-col\"><!-- wp:woocommerce/product-price {\"isDescendentOfQueryLoop\":true} /-->\n\n<!-- wp:frontline-pc/product-installment /--></div>\n<!-- /wp:group -->\n\n<!-- wp:frontline-pc/product-stock /--></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"fl-tiers__cta\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group fl-tiers__cta\"><!-- wp:woocommerce/product-button {\"isDescendentOfQueryLoop\":true} /--></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n<!-- /wp:woocommerce/product-template -->\n\n<!-- wp:woocommerce/product-collection-no-results -->\n<!-- wp:paragraph {\"className\":\"fl-prose\"} -->\n<p class=\"fl-prose\">Ingen maskiner er merket som utvalgte akkurat nå. Merk tre produkter som «utvalgt» i WooCommerce for å fylle denne seksjonen.</p>\n<!-- /wp:paragraph -->\n<!-- /wp:woocommerce/product-collection-no-results --></div>\n<!-- /wp:woocommerce/product-collection --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"className\":\"fl-section-dark\",\"layout\":{\"type\":\"default\"},\"anchor\":\"garanti\"} -->\n<section class=\"wp-block-group alignfull fl-section-dark\" id=\"garanti\"><!-- wp:html -->\n<div class=\"fl-section-dark__glow\" aria-hidden=\"true\"></div>\n<!-- /wp:html -->\n\n<!-- wp:group {\"className\":\"fl-wrap fl-section-dark__inner\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group fl-wrap fl-section-dark__inner\"><!-- wp:paragraph {\"className\":\"fl-eyebrow fl-eyebrow\\u002d\\u002don-dark\"} -->\n<p class=\"fl-eyebrow fl-eyebrow--on-dark\">Slik bygger vi</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Fire steg fra bestilling til første kamp</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"fl-steps\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group fl-steps\"><!-- wp:group {\"className\":\"fl-glass-tile\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group fl-glass-tile\"><!-- wp:html -->\n<div class=\"fl-glass-tile__top\">\n\t\t\t\t\t<span class=\"fl-icon \"><svg xmlns=\"http://www.w3.org/2000/svg\" viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"12\" cy=\"12\" r=\"10\" /><circle cx=\"12\" cy=\"12\" r=\"6\" /><circle cx=\"12\" cy=\"12\" r=\"2\" /></svg></span>\t\t\t\t\t<span class=\"fl-glass-tile__nr\">01</span>\n\t\t\t\t</div>\n<!-- /wp:html -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Du velger klasse</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Fighter, Ghost, Titan eller Prism. Er du usikker, svarer vi innen en time.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"fl-glass-tile\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group fl-glass-tile\"><!-- wp:html -->\n<div class=\"fl-glass-tile__top\">\n\t\t\t\t\t<span class=\"fl-icon \"><svg xmlns=\"http://www.w3.org/2000/svg\" viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z\" /></svg></span>\t\t\t\t\t<span class=\"fl-glass-tile__nr\">02</span>\n\t\t\t\t</div>\n<!-- /wp:html -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Vi bygger for hånd</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Kabelføring, montering og BIOS-oppsett gjøres av én tekniker i Norge.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"fl-glass-tile\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group fl-glass-tile\"><!-- wp:html -->\n<div class=\"fl-glass-tile__top\">\n\t\t\t\t\t<span class=\"fl-icon \"><svg xmlns=\"http://www.w3.org/2000/svg\" viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2\" /></svg></span>\t\t\t\t\t<span class=\"fl-glass-tile__nr\">03</span>\n\t\t\t\t</div>\n<!-- /wp:html -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Stresstest</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Full last på GPU, CPU og minne. Temperaturlogg følger med i esken.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"fl-glass-tile\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group fl-glass-tile\"><!-- wp:html -->\n<div class=\"fl-glass-tile__top\">\n\t\t\t\t\t<span class=\"fl-icon \"><svg xmlns=\"http://www.w3.org/2000/svg\" viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2\" /><path d=\"M15 18H9\" /><path d=\"M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14\" /><circle cx=\"17\" cy=\"18\" r=\"2\" /><circle cx=\"7\" cy=\"18\" r=\"2\" /></svg></span>\t\t\t\t\t<span class=\"fl-glass-tile__nr\">04</span>\n\t\t\t\t</div>\n<!-- /wp:html -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Levert klar til kamp</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Windows installert, drivere oppdatert. Slå på og spill — 5-7 dager</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"className\":\"fl-wrap fl-support\",\"layout\":{\"type\":\"default\"},\"anchor\":\"support\"} -->\n<section id=\"support\" class=\"wp-block-group fl-wrap fl-support\"><!-- wp:group {\"className\":\"fl-support__panel\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group fl-support__panel\"><!-- wp:group {\"className\":\"fl-support__left\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group fl-support__left\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Usikker på hvilken klasse?</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Send oss spillene dine og skjermen du bruker. Vi svarer med én anbefaling — ikke et prisark.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:html -->\n<div class=\"fl-support__ctas\">\n\t\t\t\t<a class=\"fl-btn fl-btn--md fl-btn--accent\" href=\"http://localhost:8090/contact-us/\"><span class=\"fl-icon \"><svg xmlns=\"http://www.w3.org/2000/svg\" viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\" /></svg></span>Chat med oss</a>\n\t\t\t\t\t\t\t</div>\n<!-- /wp:html --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"fl-support__right\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group fl-support__right\"><!-- wp:paragraph {\"className\":\"fl-eyebrow\"} -->\n<p class=\"fl-eyebrow\">Nyhetsbrev</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Nye bygg, lagerslipp og kampanjer — én e-post i måneden. Ingen støy.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:html -->\n<form class=\"fl-newsletter\" action=\"\" method=\"post\">\n\t\t\t\t\t<label class=\"screen-reader-text\" for=\"fl-newsletter-email\">E-postadresse</label>\n\t\t\t\t\t<span class=\"fl-newsletter__field\"><span class=\"fl-icon \"><svg xmlns=\"http://www.w3.org/2000/svg\" viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><rect width=\"20\" height=\"16\" x=\"2\" y=\"4\" rx=\"2\" /><path d=\"m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7\" /></svg></span><input type=\"email\" id=\"fl-newsletter-email\" name=\"fl_email\" placeholder=\"din@epost.no\" autocomplete=\"email\" required /></span>\n\t\t\t\t\t<button type=\"submit\" class=\"fl-btn fl-btn--md fl-btn--primary\">Meld meg på</button>\n\t\t\t\t</form>\n<!-- /wp:html -->\n\n<!-- wp:html -->\n<p class=\"fl-note\"><span class=\"fl-icon \"><svg xmlns=\"http://www.w3.org/2000/svg\" viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><rect width=\"18\" height=\"11\" x=\"3\" y=\"11\" rx=\"2\" ry=\"2\" /><path d=\"M7 11V7a5 5 0 0 1 10 0v4\" /></svg></span>Vi deler aldri e-posten din.</p>\n<!-- /wp:html --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->",
