{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "frontline-pc/product-stock",
	"title": "Product stock badge",
	"category": "woo-commerce",
	"description": "The design's soft status pill, driven by the product's real stock status.",
	"textdomain": "frontline-pc",
	"usesContext": [
		"postId",
		"postType"
	],
	"supports": {
		"html": false,
		"reusable": false,
		"inserter": false
	},
	"render": "file:./render.php",
	"editorScript": "frontline-pc-product-stock-editor",
	"attributes": {
		"inStockLabel": {
			"type": "string",
			"default": ""
		},
		"backorderLabel": {
			"type": "string",
			"default": ""
		},
		"outOfStockLabel": {
			"type": "string",
			"default": ""
		}
	}
}
